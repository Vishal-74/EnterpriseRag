# Copy to .env in the repository root. Never commit the copy.

# postgresql+asyncpg:// is accepted, as is the standard postgresql:// URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/enterprise_intel

# Generate a long random string. Required.
JWT_SECRET=replace-with-a-long-random-string

ENVIRONMENT=development
LOG_LEVEL=INFO

# Comma-separated browser origins allowed to call the API directly.
CORS_ORIGINS=http://localhost:3000

# Provider keys. Leave blank until you have them. The API still boots.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
ANTHROPIC_CHAT_MODEL=claude-3-5-haiku-latest
EMBEDDING_MODEL=text-embedding-3-small

# Hugging Face fallback provider
HF_TOKEN=
HF_BASE_URL=
HF_MODEL_ID=

# Frontend server (not exposed to the browser bundle).
API_URL=http://localhost:8000
JWT_COOKIE_SECRET=

# Optional demo seed. Used only by backend/scripts/seed_demo.py.
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=
